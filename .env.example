# Salin file ini menjadi .env lalu isi nilainya.

# Wajib. Dapatkan dari https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Model Gemini yang dipakai untuk transkripsi, memilih momen, dan melacak wajah.
# Nama model berubah dari waktu ke waktu. Jika muncul error "model not found",
# cek nama model terbaru yang mendukung audio dan video di Google AI Studio.
GEMINI_MODEL=gemini-3.6-flash

# Folder hasil. Setiap job dibuat di subfolder sendiri.
WORK_DIR=output

# Durasi klip dalam detik.
CLIP_MIN_SEC=30
CLIP_MAX_SEC=60

# Jumlah klip default di halaman web (maksimum 20).
DEFAULT_CLIP_COUNT=10

# Resolusi maksimum video yang diunduh. 720 cukup untuk Shorts dan lebih cepat.
MAX_VIDEO_HEIGHT=720
